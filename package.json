{
  "name": "limadata-mcp",
  "version": "0.1.0",
  "description": "MCP server for Limadata API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/server.js",
    "start": "node dist/server.js",
    "watch": "tsc --watch",
    "docker:build": "docker build -t limadata-mcp:latest .",
    "docker:run": "docker run -e LIMADATA_API_KEY=$LIMADATA_API_KEY limadata-mcp:latest",
    "setup:claude-desktop": "bash scripts/setup-claude-desktop.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
